{
  "name": "axios-sse",
  "version": "2.0.0",
  "description": "A lightweight Server-Sent Events (SSE) client built on Axios with auto-reconnect, JSON parsing, and full streaming control.",
  "type": "module",
  "main": "dist/node.cjs",
  "module": "dist/node.mjs",
  "types": "dist/node.d.mts",
  "exports": {
    ".": {
      "browser": {
        "require": {
          "types": "./dist/browser.d.cts",
          "require": "./dist/browser.cjs"
        },
        "import": {
          "types": "./dist/browser.d.mts",
          "import": "./dist/browser.mjs"
        }
      },
      "require": {
        "types": "./dist/node.d.cts",
        "require": "./dist/node.cjs"
      },
      "import": {
        "types": "./dist/node.d.mts",
        "import": "./dist/node.mjs"
      }
    }
  },
  "unpkg": "dist/browser.iife.js",
  "jsdelivr": "dist/browser.iife.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "type-check": "tsc --noEmit && cd test && tsc --noEmit",
    "test": "vitest run",
    "prettier": "prettier --write \"**/*.{vue,js,ts,json,html,css,scss,md,mjs}\"",
    "prepublishOnly": "pnpm run build --publint",
    "format": "pnpm run prettier && pnpm run lint:fix"
  },
  "keywords": [
    "axios",
    "sse",
    "server-sent-events",
    "typescript",
    "streaming",
    "real-time"
  ],
  "author": "Steven-Qiang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steven-Qiang/axios-sse.git"
  },
  "bugs": {
    "url": "https://github.com/Steven-Qiang/axios-sse/issues"
  },
  "homepage": "https://github.com/Steven-Qiang/axios-sse#readme",
  "peerDependencies": {
    "axios": "*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "eslint-plugin-format": "^2.0.1",
    "express": "^5.2.1",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "publint": "^0.3.18",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@10.32.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
